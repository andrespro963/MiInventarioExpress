{{#if errores}}
    <ul style="color:red;">
        {{#each errores}}
            <li>{{this.msg}}</li>
        {{/each}}
    </ul>
{{/if}}

<h1>Crear Producto</h1>

<form action="/productos" method="POST" enctype="multipart/form-data">
<input type="text" name="nombre" placeholder="Nombre" value="{{datos.nombre}}"><br>

<input type="number" name="precio" placeholder="Precio" value="{{datos.precio}}"><br>

<textarea name="descripcion" placeholder="Descripción">{{datos.descripcion}}</textarea><br>

    <input type="file" name="imagen"><br>

    <button type="submit">Guardar</button>
</form>